<Window x:Class="KwiAutomationLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KWI Automation Center"
        Width="980"
        Height="820"
        MinWidth="820"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,24,32,22" CornerRadius="0,0,22,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#123F46" Offset="0" />
                    <GradientStop Color="#1C6668" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.17" Color="#173D41" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#2A7475" CornerRadius="7" Padding="9,5" Margin="0,0,12,0">
                            <TextBlock Text="KWI" Foreground="White" FontWeight="Bold" FontSize="13" />
                        </Border>
                        <Border Background="#2CFFFFFF" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#9DE3C8" Margin="0,0,7,0" />
                                <TextBlock Text="LIVE MODE" Foreground="#E8FFFA" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Automation Center" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,2" />
                    <TextBlock Text="A calm, guided refresh of your daily Momentus data." Foreground="#CFE5E2" FontSize="14" />
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1" Background="#1EFFFFFF" CornerRadius="12" Padding="20,12" MinWidth="158">
                    <StackPanel>
                        <TextBlock Text="ELAPSED TIME" Foreground="#BFDAD7" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ElapsedText}" Foreground="White" FontSize="27" FontWeight="Light" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderStatusText}" Foreground="#E8F5F3" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding CompletedSummary}" Foreground="#CFE5E2" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Grid.Row="1" Value="{Binding ProgressValue}" Maximum="100" Height="7" Margin="0,9,0,0"
                                 Foreground="#8FD4C0" Background="#2EFFFFFF" BorderThickness="0" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,22,26,14" Visibility="{Binding ProgressVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="6,0,6,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Run sequence" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Each job finishes before the next one begins." Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentStepLabel}" Foreground="#4D7778" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding CardBackground}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Margin="5"
                                    Padding="13,11"
                                    MinHeight="72">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="9" ShadowDepth="1" Opacity="0.07" Color="#31585B" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{Binding IndicatorBackground}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IndicatorText}" Foreground="{Binding IndicatorForeground}"
                                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedInkBrush}" FontSize="10.5" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="10.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DurationText}" Foreground="#829294" FontSize="10" Margin="0,3,0,0"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Margin="26,22,26,14" Visibility="{Binding SummaryVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="6,0,6,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Run summary" Foreground="{StaticResource InkBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="What changed, what completed, and what may need a closer look." Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding SummaryBadgeBackground}" CornerRadius="13" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryBadgeText}" Foreground="{Binding SummaryBadgeForeground}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="1,0,1,13">
                <Border Background="White" BorderBrush="#DDE9E7" BorderThickness="1" CornerRadius="10" Margin="5" Padding="13,10">
                    <StackPanel>
                        <TextBlock Text="JOBS COMPLETE" Foreground="{StaticResource MutedInkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryCompletedValue}" Foreground="{StaticResource InkBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDE9E7" BorderThickness="1" CornerRadius="10" Margin="5" Padding="13,10">
                    <StackPanel>
                        <TextBlock Text="NEW WAREHOUSE ROWS" Foreground="{StaticResource MutedInkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryNewValue}" Foreground="#347B76" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDE9E7" BorderThickness="1" CornerRadius="10" Margin="5" Padding="13,10">
                    <StackPanel>
                        <TextBlock Text="UPDATED ROWS" Foreground="{StaticResource MutedInkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryUpdatedValue}" Foreground="#347B76" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDE9E7" BorderThickness="1" CornerRadius="10" Margin="5" Padding="13,10">
                    <StackPanel>
                        <TextBlock Text="ITEMS TO REVIEW" Foreground="{StaticResource MutedInkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryAlertsValue}" Foreground="{Binding SummaryAlertsBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SummaryItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="5,4" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="205" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="29" Height="29" CornerRadius="15" Background="{Binding IndicatorBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding IndicatorText}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Headline}" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedInkBrush}" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE8E6" BorderThickness="0,1,0,0" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding FooterStatusBrush}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding FooterStatusText}" Foreground="{StaticResource InkBrush}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FooterDetailText}" Foreground="{StaticResource MutedInkBrush}" FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding ViewToggleText}" Click="ToggleView_Click" Visibility="{Binding SummaryToggleVisibility}" Margin="0,0,9,0" />
                    <Button Content="Open log folder" Click="OpenLogs_Click" Margin="0,0,9,0" />
                    <Button Content="Close" Click="Close_Click" IsEnabled="{Binding CanClose}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
