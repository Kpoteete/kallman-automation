<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Ungerboeck.Api.Sdk" Version="1.262.8.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="SalesRepLookup.xlsx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="OrderCategoryLookup.xlsx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="billing-config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Run-Scheduled.ps1" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Install-ServerTask.ps1" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Verify-ServerTask.ps1" CopyToPublishDirectory="PreserveNewest" />
    <None Update="SCHEDULING.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
